      <span class="soon-panel__star soon-panel__star--two" aria-hidden="true">✧</span>
      <p class="soon-panel__eyebrow">Estamos preparando nuevos encuentros</p>
      <div class="soon-ribbons" aria-label="Próximamente">
        <span class="soon-ribbon soon-ribbon--back" aria-hidden="true">Próxima apertura</span>
        <span class="soon-ribbon soon-ribbon--front">Próximamente</span>
