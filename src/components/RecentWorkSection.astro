---
---
<section id="obra" class="recent-scene"><div class="wrap">
    <h2 class="rv">Obra reciente</h2>
    <div class="recent-featured rv" aria-label="Piezas destacadas de la colección de calaveras">
      <figure class="showpiece showpiece--altar" data-recent-index="0" role="button" tabindex="0" aria-haspopup="dialog" aria-label="Ampliar: Tradición que florece">
        <span class="showpiece__orbit" aria-hidden="true"></span>
        <span class="showpiece__spark showpiece__spark--one" aria-hidden="true"></span>
        <span class="showpiece__spark showpiece__spark--two" aria-hidden="true"></span>
        <span class="showpiece__spark showpiece__spark--three" aria-hidden="true"></span>
        <div class="showpiece__frame">
          <img src="/img/banner/calaverasbanner.jpeg" alt="Altar artesanal con catrinas, flores y calaveras decoradas" loading="lazy">
        </div>
        <figcaption><span>Escena de ofrenda</span><strong>Tradición que florece</strong></figcaption>
      </figure>
      <figure class="showpiece showpiece--trio" data-recent-index="1" role="button" tabindex="0" aria-haspopup="dialog" aria-label="Ampliar: Tres almas, tres colores">
        <span class="showpiece__orbit" aria-hidden="true"></span>
        <span class="showpiece__spark showpiece__spark--one" aria-hidden="true"></span>
        <span class="showpiece__spark showpiece__spark--two" aria-hidden="true"></span>
        <span class="showpiece__spark showpiece__spark--three" aria-hidden="true"></span>
        <div class="showpiece__frame">
          <img src="/img/banner/calaverastrio.jpeg" alt="Tres catrinas artesanales con detalles florales y coloridos" loading="lazy">
        </div>
        <figcaption><span>Retratos de calavera</span><strong>Tres almas, tres colores</strong></figcaption>
      </figure>
    </div>
    <div class="sw rv">
      <figure class="work-card work-card--collection" data-recent-index="2" role="button" tabindex="0" aria-haspopup="dialog" aria-label="Ampliar: Colección de catrinas">
        <img src="/img/catalog/catrinasofrenda.png" alt="Catrinas artesanales reunidas en una ofrenda colorida" loading="lazy">
        <figcaption><span>Colección artesanal</span><strong>Colección de catrinas</strong></figcaption>
      </figure>
      <figure class="work-card work-card--blue" data-recent-index="3" role="button" tabindex="0" aria-haspopup="dialog" aria-label="Ampliar: Catrina azul de girasoles">
        <img src="/img/catalog/catrinazaulnueva.png" alt="Catrina azul de porcelana con flores de cempasúchil" loading="lazy">
        <figcaption><span>Color y tradición</span><strong>Catrina azul de girasoles</strong></figcaption>
      </figure>
      <figure class="work-card work-card--scarecrow" data-recent-index="4" role="button" tabindex="0" aria-haspopup="dialog" aria-label="Ampliar: Espantapájaros del maizal">
        <img src="/img/catalog/espantapajarosotonal.png" alt="Espantapájaros otoñal con cabeza de calabaza en un maizal" loading="lazy">
        <figcaption><span>Temporada de otoño</span><strong>Espantapájaros del maizal</strong></figcaption>
      </figure>
    </div>
    <a class="btn b" href="#" data-go="shop" data-to="galeria">Ver toda su arte</a>
  </div></section>
