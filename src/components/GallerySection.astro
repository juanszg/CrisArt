      <figure class="work-card--blue"><img src="/img/banner/calaverastrio.jpeg" alt="Tres almas, tres colores"><figcaption>Tres almas, tres colores</figcaption></figure>
      <figure class="work-card--collection"><img src="/img/catalog/catrinasofrenda.png" alt="Colección de catrinas"><figcaption>Colección de catrinas</figcaption></figure>
      <figure class="work-card--blue"><img src="/img/catalog/catrinazaulnueva.png" alt="Catrina azul de girasoles"><figcaption>Catrina azul de girasoles</figcaption></figure>
      <figure class="work-card--scarecrow"><img src="/img/catalog/espantapajarosotonal.png" alt="Espantapájaros del maizal"><figcaption>Espantapájaros del maizal</figcaption></figure>
